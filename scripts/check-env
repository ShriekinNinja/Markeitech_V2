#!/usr/bin/env bash
set -euo pipefail

python3 --version
uv --version
node --version
npm --version

python3 - <<'PY'
import sys

if sys.version_info[:2] != (3, 13):
    raise SystemExit("Python 3.13 is required for this Stage 0 bootstrap.")
PY

node - <<'JS'
const version = process.versions.node.split(".").map(Number);
const supported = version[0] > 22 || (version[0] === 22 && version[1] >= 12) || (version[0] === 20 && version[1] >= 19);
if (!supported) {
  throw new Error("Node.js 20.19+ or 22.12+ is required by current Vite.");
}
JS

echo "Stage 0 environment checks passed."
