# Runtime posture
MARKEITECH_ENV=local
MARKEITECH_MODE=data_only
MARKEITECH_ENABLE_EXECUTION=false

# Interactive Brokers / TWS / Gateway
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
IB_TRADING_MODE=paper
IB_READ_ONLY_API=true

# Required before Stage 2 market-data startup.
NQ_SYMBOL=NQ
NQ_EXCHANGE=CME
NQ_CONTRACT_EXPIRY=YYYYMMDD
NQ_INSTRUMENT_ID=

# Local storage
SQLITE_PATH=data/runtime/markeitech.sqlite3
PARQUET_CATALOG_PATH=data/catalog
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=127.0.0.1
API_PORT=8000
