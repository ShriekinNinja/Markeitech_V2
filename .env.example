# Runtime posture
MARKEITECH_ENV=local
MARKEITECH_MODE=data_only
MARKEITECH_ENABLE_EXECUTION=false

# Interactive Brokers / TWS / Gateway
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
IB_TRADING_MODE=paper
IB_READ_ONLY_API=true

# Required before Stage 2 market-data startup.
ACTIVE_INSTRUMENT_ID=
NQ_SYMBOL=NQ
NQ_EXCHANGE=CME
NQ_CONTRACT_EXPIRY=YYYYMMDD
NQ_INSTRUMENT_ID=

# Optional Stage 2+ background monitors, comma-separated instrument ids.
# Background instruments warm up from history, then track live 1-minute bars.
BACKGROUND_INSTRUMENT_IDS=

# Local storage
SQLITE_PATH=data/runtime/markeitech.sqlite3
PARQUET_CATALOG_PATH=data/catalog
REDIS_URL=redis://localhost:6379/0

# Discord incoming webhooks. Keep real URLs only in the ignored local .env file.
# Signal lifecycle is required when the current [discord] route is enabled.
MARKEITECH_DISCORD_SIGNALS_WEBHOOK=
# Reserved for the next market-event and runtime-health routes.
MARKEITECH_DISCORD_MARKET_EVENTS_WEBHOOK=
MARKEITECH_DISCORD_RUNTIME_HEALTH_WEBHOOK=

# API
API_HOST=127.0.0.1
API_PORT=8000
