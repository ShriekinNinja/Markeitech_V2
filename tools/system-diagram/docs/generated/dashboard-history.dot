digraph "Dashboard History Request and Projection" {
	graph [bgcolor="#0B1118" fontcolor="#F2F6FA" fontname=Helvetica fontsize=18 forcelabels=true label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT COLOR="#F2F6FA" POINT-SIZE="20"><B>Dashboard History Request and Projection</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFC1BB" POINT-SIZE="11"><B>OFFLINE DOCUMENTATION &#8212; NO CURRENT ORDER SUBMISSION OR EXECUTION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#C7D2DD" POINT-SIZE="10">PROFILE: profile.example &#183; REVIEW: PROPOSED &#183; MANIFEST SCHEMA: 1 &#183; COMPONENTS: 7 &#183; CAPABILITIES: 2 &#183; FLOWS: 10</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#C7D2DD" POINT-SIZE="9">CHECKOUT EVIDENCE: a382f2e0636cdb3148b451e3e0e8239a684438e5</FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="8" CELLPADDING="0"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#78A9F5" BGCOLOR="#164C3E"><TR><TD><FONT COLOR="#EEF5FF" POINT-SIZE="9"><B>ENABLED</B></FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#F0A45D" BGCOLOR="#5A3419"><TR><TD><FONT COLOR="#FFF4E8" POINT-SIZE="9"><B>EXTERNAL</B></FONT></TD></TR></TABLE></TD><TD><FONT COLOR="#B9DDF0" POINT-SIZE="9"><B>DATA · SOLID/DASHED</B></FONT></TD><TD><FONT COLOR="#E8DFAF" POINT-SIZE="9"><B>PROJECT · DOTTED</B></FONT></TD><TD><FONT COLOR="#C7D2DD" POINT-SIZE="9">R = REQUIRED &#183; O = OPTIONAL</FONT></TD></TR></TABLE></TD></TR></TABLE>> labeljust=l labelloc=t margin=0.15 nodesep=0.45 outputorder=edgesfirst overlap=false pack=true packmode="graph" pad=0.35 rankdir=LR ranksep=0.85 splines=spline]
	node [fixedsize=false fontcolor="#F4F7FA" fontname=Helvetica fontsize=10 height=0.9 imagescale=true labelloc=b margin="0.12,0.08" shape=box style=rounded width=2.2]
